# JIRA Cloud basic-auth credentials for the timer — each user needs their OWN token.
# 1. Generate a token: https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Copy this file to .env.local and fill in JIRA_EMAIL + JIRA_API_TOKEN.
# The token acts as you, so the app shows YOUR assigned stories automatically.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=paste-your-token-here
# Board the UI preselects on load: case-insensitive substring of the board name.
# Leave blank to just take the first board you have access to.
JIRA_BOARD_MATCH=
# Round logged time to the nearest N minutes when writing worklogs.
TIMER_ROUND_MINUTES=5
